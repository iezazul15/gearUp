model RentalOrder {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  startDate   DateTime
  endDate     DateTime
  status      RentalStatus @default(PLACED)
  totalAmount Decimal      @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    RentalOrderItem[]
  payments Payment[]
  reviews  Review?

  @@map("rental_orders")
}

model RentalOrderItem {
  id            String      @id @default(uuid())
  rentalOrderId String
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id])

  gearItemId String
  gearItem   GearItem @relation(fields: [gearItemId], references: [id])

  quantity    Int     @default(1)
  pricePerDay Decimal @db.Decimal(10, 2)

  @@unique([rentalOrderId, gearItemId])
  @@map("rental_order_items")
}
